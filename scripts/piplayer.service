[Unit]
Description=PiPlayer network-controlled video player
# No network ordering at all, deliberately. Nothing here talks to the network at
# startup and the web server binds 0.0.0.0, which accepts interfaces that appear
# later, so neither target buys anything. Measured on a Pi 3: waiting for
# network-online.target put the picture on screen at 30.1s and plain
# network.target at 25.5s (it cannot be reached until NetworkManager has
# started, ~5s). The display hardware is bound at 12.4s; everything after that
# was the player waiting for a network it never uses.
After=sound.target systemd-udev-settle.service

[Service]
Type=simple
User=piplayer
Group=piplayer
SupplementaryGroups=video render audio gpio
WorkingDirectory=/opt/piplayer
Environment=PYTHONUNBUFFERED=1
Environment=PIPLAYER_DATA=/var/lib/piplayer
Environment=PIPLAYER_PORT=@PORT@
Environment=PIPLAYER_BACKEND=kms
ExecStart=/usr/bin/python3 -m piplayer
# bind to port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Headroom for file descriptors (dmabufs, V4L2 devices, sockets)
LimitNOFILE=16384
# Allow a core dump when the process is killed by a signal. systemd's default
# is 0, which silently discards them; systemd-coredump (see scripts/diagnostics.sh)
# needs this to capture anything.
LimitCORE=infinity
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
