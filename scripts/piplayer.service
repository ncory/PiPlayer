[Unit]
Description=PiPlayer network-controlled video player
# Deliberately NOT network-online.target: nothing here talks to the network at
# startup and the web server binds 0.0.0.0, which covers interfaces that appear
# later. Waiting for NetworkManager to report connectivity delayed the start of
# playback by about 14 seconds on a Pi 3 -- the display hardware is ready long
# before the network is.
After=network.target sound.target systemd-udev-settle.service

[Service]
Type=simple
User=piplayer
Group=piplayer
SupplementaryGroups=video render audio gpio
WorkingDirectory=/opt/piplayer
Environment=PYTHONUNBUFFERED=1
Environment=PIPLAYER_DATA=/var/lib/piplayer
Environment=PIPLAYER_PORT=@PORT@
Environment=PIPLAYER_BACKEND=kms
ExecStart=/usr/bin/python3 -m piplayer
# bind to port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Headroom for file descriptors (dmabufs, V4L2 devices, sockets)
LimitNOFILE=16384
# Allow a core dump when the process is killed by a signal. systemd's default
# is 0, which silently discards them; systemd-coredump (see scripts/diagnostics.sh)
# needs this to capture anything.
LimitCORE=infinity
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
